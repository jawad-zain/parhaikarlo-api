SECRET_KEY=change-me-generate-with-get_random_secret_key
# Django core
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GROQ_API_KEY=your-groq-key-here
DB_NAME=parhaikarlo
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Frontend base URL — used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000

# Email — defaults to printing emails to this terminal (no credentials needed).
# To send real email via Gmail SMTP, uncomment and fill these in:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-google-app-password
# DEFAULT_FROM_EMAIL=ParhaiKarlo <you@gmail.com>

# Media storage — defaults to local disk (media/). In production, set
# USE_S3_MEDIA=True and fill these in to store question images (and any
# other uploads) in a Backblaze B2 bucket instead. See B2 console →
# "App Keys" for the key id/application key, and the bucket's details
# page for its S3-compatible endpoint.
# USE_S3_MEDIA=True
# B2_KEY_ID=your-application-key-id
# B2_APPLICATION_KEY=your-application-key
# B2_BUCKET_NAME=parhaikarlo-media
# B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# Optional — a Cloudflare (or other CDN) domain fronting the bucket, to
# avoid B2's per-GB egress cost on image reads:
# B2_CUSTOM_DOMAIN=media.parhaikarlo.com
